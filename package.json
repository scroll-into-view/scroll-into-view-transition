{
  "name": "scroll-into-view-transition",
  "version": "0.1.2",
  "description": "Smoothly scroll elements into view using the CSS View Transitions API",
  "keywords": [
    "behavior-smooth",
    "if-needed",
    "ponyfill",
    "scroll",
    "scroll-into-view",
    "scrollIntoView",
    "scrollIntoViewIfNeeded",
    "smooth",
    "typescript",
    "view-transition",
    "view-transitions"
  ],
  "homepage": "https://github.com/scroll-into-view/scroll-into-view-transition#readme",
  "bugs": {
    "url": "https://github.com/scroll-into-view/scroll-into-view-transition/issues"
  },
  "license": "MIT",
  "author": "Cody Olsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scroll-into-view/scroll-into-view-transition.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./middleware": "./dist/middleware.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && pnpm run check:es",
    "check:es": "es-check es2017 --module dist/index.mjs dist/middleware.mjs",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "compute-scroll-into-view": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "5.1.0",
    "browserslist": "^4.29.5",
    "es-check": "^9.9.0",
    "jsdom": "^31.0.1",
    "playwright": "*",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0"
  },
  "browserslist": [
    "baseline 2019"
  ],
  "packageManager": "pnpm@12.21.0"
}
