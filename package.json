{
  "name": "scroll-into-view-transition",
  "version": "0.1.1",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/scroll-into-view/scroll-into-view-transition#readme",
  "bugs": {
    "url": "https://github.com/scroll-into-view/scroll-into-view-transition/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scroll-into-view/scroll-into-view-transition.git"
  },
  "files": [
    "dist"
  ],
